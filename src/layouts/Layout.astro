---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import '/node_modules/flag-icons/css/flag-icons.min.css';
import { LanguageOption, LocaleCode, type LayoutProps } from '../types';
import { createTranslator } from '../utils/ui';

const { title, description, canonical, locale = LocaleCode.EN } = Astro.props as LayoutProps;

const themePreference = Astro.cookies.get('theme')?.value ?? 'system';
const isDarkTheme = themePreference === 'dark';
const t = createTranslator(locale);
const currentLocale = locale;

const theme = Astro.cookies.get('theme')?.value ?? 'system';

const languages: LanguageOption[] = [
  {
    code: 'en',
    label: t('common.languages.en'),
    labelKey: 'common.languages.en',
    flag: 'fi fi-gb',
  },
  {
    code: 'fr',
    label: t('common.languages.fr'),
    labelKey: 'common.languages.fr',
    flag: 'fi fi-fr',
  },
  {
    code: 'kin',
    label: t('common.languages.kin'),
    labelKey: 'common.languages.kin',
    flag: 'fi fi-rw',
  },
];
---

<!doctype html>
<html lang={locale} class:list={['preload', { dark: isDarkTheme }]} data-theme={themePreference}>
  <head>
    <script is:inline>
      (function () {
        try {
          var cookieTheme = document.cookie.match(/(?:^|; )theme=([^;]+)/);
          var theme = cookieTheme
            ? decodeURIComponent(cookieTheme[1])
            : localStorage.getItem('theme') || 'system';
          var resolved =
            theme === 'system'
              ? window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : theme;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.classList.toggle('dark', resolved === 'dark');
          // keep preload class to disable transitions; it will be removed on DOMContentLoaded by client script
        } catch (e) {
          void e;
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta -->
    <title>{title}</title>

    <meta data-i18n="landing.meta.title" data-i18n-attr="content" name="title" content={title} />

    <meta data-i18n-attr="content" name="description" content={description} />

    <meta
      name="keywords"
      content="Banka, digital banking, fintech, Africa banking, online payments, modern banking, virtual cards, financial platform, business banking, secure banking"
    />

    <meta name="author" content="Banka" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme -->
    <meta name="theme-color" content="#0f172a" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Icons -->
    <link rel="icon" type="image/jpg+png" href="/banka.png" />
    <link rel="icon" href="/banka.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />

    <meta
      data-i18n="landing.meta.title"
      data-i18n-attr="content"
      property="og:title"
      content={title}
    />

    <meta
      data-i18n="landing.meta.description"
      data-i18n-attr="content"
      property="og:description"
      content={description}
    />

    <meta property="og:url" content={canonical} />

    <meta property="og:site_name" content="Banka" />

    <meta property="og:image" content="https://banka.com/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      data-i18n="landing.meta.title"
      data-i18n-attr="content"
      name="twitter:title"
      content={title}
    />

    <meta
      data-i18n="landing.meta.description"
      data-i18n-attr="content"
      name="twitter:description"
      content={description}
    />

    <meta name="twitter:image" content="https://banka.com/og-image.png" />
  </head>

  <body>
    <Nav t={t} languages={languages} currentLocale={currentLocale} theme={theme} />

    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
