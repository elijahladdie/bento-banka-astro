---
import {
  ArrowLeft,
  CircleCheck,
  CircleX,
  House,
  LoaderCircle,
  TriangleAlert,
} from "@lucide/astro";
import Layout from "../layouts/Layout.astro";

const locale = Astro.locals.locale || "en";
---

<Layout
  title="Checkout Status — Banka"
  description="Checkout result page"
  canonical="https://banka.com/success"
  locale={locale}
>
  <section
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-white px-6 py-20 text-slate-900 dark:bg-[#030712] dark:text-white"
  >
    <!-- background -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.15),transparent_40%)]"
    >
    </div>

    <!-- loading state -->
    <div
      id="loading-state"
      class="relative z-10 flex items-center justify-center py-16"
    >
      <div class="flex flex-col items-center gap-4">
        <LoaderCircle
          class="h-12 w-12 animate-spin text-blue-500"
        />

        <p class="text-sm text-slate-500 dark:text-slate-400">
          Loading checkout status...
        </p>
      </div>
    </div>

    <!-- status card -->
    <div
      id="status-card"
      class="relative z-10 hidden w-full max-w-xl rounded-3xl border border-black/10 bg-white/80 p-8 shadow-2xl backdrop-blur dark:border-white/10 dark:bg-white/5"
    >
      <!-- status icon -->
      <div
        id="status-icon-wrapper"
        class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500"
      >
        <TriangleAlert
          id="status-warning-icon"
          class="h-10 w-10"
        />

        <CircleCheck
          id="status-success-icon"
          class="hidden h-10 w-10"
        />

        <CircleX
          id="status-failed-icon"
          class="hidden h-10 w-10"
        />
      </div>

      <!-- title -->
      <h1
        id="status-title"
        class="mb-4 text-center text-3xl font-bold tracking-tight"
      >
        Checkout Not Completed
      </h1>

      <!-- message -->
      <p
        id="status-message"
        class="mx-auto mb-8 max-w-md text-center text-base leading-7 text-slate-600 dark:text-slate-300"
      >
        Your checkout session was not completed. Please return and try again.
      </p>

      <!-- actions -->
      <div
        class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center"
      >
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-xl btn-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-500"
        >
          <House class="h-4 w-4" />
          Go Home
        </a>

        <button
          id="back-button"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-black/10 px-6 py-3 text-sm font-semibold transition hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/10"
        >
          <ArrowLeft class="h-4 w-4" />
          Go Back
        </button>
      </div>
    </div>
  </section>

  <script>
    const loadingState =
      document.getElementById(
        "loading-state",
      );

    const statusCard =
      document.getElementById(
        "status-card",
      );

    const status =
      sessionStorage.getItem(
        "checkout-status",
      );

    const message =
      sessionStorage.getItem(
        "checkout-message",
      );

    const titleEl =
      document.getElementById(
        "status-title",
      );

    const messageEl =
      document.getElementById(
        "status-message",
      );

    const iconWrapper =
      document.getElementById(
        "status-icon-wrapper",
      );

    const successIcon =
      document.getElementById(
        "status-success-icon",
      );

    const failedIcon =
      document.getElementById(
        "status-failed-icon",
      );

    const warningIcon =
      document.getElementById(
        "status-warning-icon",
      );

    const backButton =
      document.getElementById(
        "back-button",
      );

    function resetIcons() {
      successIcon?.classList.add(
        "hidden",
      );

      failedIcon?.classList.add(
        "hidden",
      );

      warningIcon?.classList.add(
        "hidden",
      );
    }

    function showCard() {
      loadingState?.classList.add(
        "hidden",
      );

      statusCard?.classList.remove(
        "hidden",
      );
    }

    if (
      status === "success"
    ) {
      resetIcons();

      successIcon?.classList.remove(
        "hidden",
      );

      if (iconWrapper) {
        iconWrapper.className =
          "mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-green-500/10 text-green-500";
      }

      if (titleEl) {
        titleEl.textContent =
          "Payment Successful";
      }

      if (messageEl) {
        messageEl.textContent =
          message ??
          "Your payment was completed successfully.";
      }
    } else if (
      status === "failed"
    ) {
      resetIcons();

      failedIcon?.classList.remove(
        "hidden",
      );

      if (iconWrapper) {
        iconWrapper.className =
          "mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-red-500/10 text-red-500";
      }

      if (titleEl) {
        titleEl.textContent =
          "Payment Failed";
      }

      if (messageEl) {
        messageEl.textContent =
          message ??
          "Your payment could not be completed.";
      }
    } else {
      resetIcons();

      warningIcon?.classList.remove(
        "hidden",
      );

      if (iconWrapper) {
        iconWrapper.className =
          "mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500";
      }

      if (titleEl) {
        titleEl.textContent =
          "Checkout Not Completed";
      }

      if (messageEl) {
        messageEl.textContent =
          "No checkout information was found. Please return to the previous page and try again.";
      }
    }

    // showCard();
    setTimeout(() => {
  showCard();
}, 2000);

    backButton?.addEventListener(
      "click",
      () => {
        sessionStorage.removeItem(
          "checkout-status",
        );

        sessionStorage.removeItem(
          "checkout-message",
        );

        if (
          window.history.length > 1
        ) {
          window.history.back();
        } else {
          window.location.href =
            "/";
        }
      },
    );
  </script>
</Layout>