---
import Landing from '../components/Landing.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

export const prerender = false;

const locale = Astro.locals.locale || "en";
---


<Layout
	title="Banka — Modern Digital Banking for Africa"
	description="Banka is a modern digital banking platform helping individuals and businesses manage payments, savings, transfers, and financial growth with speed, security, and simplicity."
	canonical="https://banka.com/"
	locale={locale}
>
	<Landing locale={locale} />
</Layout>
