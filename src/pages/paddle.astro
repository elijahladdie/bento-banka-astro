---
export const prerender = false;

import { LocaleCode, ThemePreference } from '../types';
import AmbientBackground from '../components/ui/AmbientBackground.astro';
import Layout from '../layouts/Layout.astro';
import { getThemePreference, resolveThemePreference } from '../utils/theme';

const locale: LocaleCode = Astro.locals.locale || 'en';

const priceId = Astro.url.searchParams.get('priceId') ?? '';
const resolvedTheme = resolveThemePreference(getThemePreference() as ThemePreference);
const paddleToken = import.meta.env.PUBLIC_PADDLE_TOKEN ?? '';
---

<Layout
  title="Checkout — Banka"
  description="Complete your payment securely with Paddle inline checkout."
  canonical="https://banka.com/paddle-checkout"
  locale={locale}
>
  <AmbientBackground />

  <section class="relative z-10 flex min-h-screen items-center justify-center px-4 py-16 sm:py-20">
    <div class="w-full max-w-5xl">
      <div
        id="checkout-error"
        class="mb-4 hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-200"
        role="alert"
        aria-live="polite"
      >
      </div>

      <!-- class="checkout-container min-h-[520px] rounded-3xl  p-4 shadow-sm backdrop-blur-[var(--glass-blur-heavy)] sm:p-6" -->
      <div
        class="checkout-container min-h-[520px] rounded-3xl border border-[var(--glass-border)] bg-white p-4 shadow-sm backdrop-blur-[var(--glass-blur-heavy)] sm:p-6"
        data-price-id={priceId}
        data-theme={resolvedTheme}
        data-locale={locale}
        data-paddle-token={paddleToken}
      >
      </div>
    </div>
  </section>
</Layout>
