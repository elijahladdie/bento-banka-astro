---
export interface Props {
  theme?: "system" | "dark" | "light";
  label: string;
  systemLabel: string;
  darkLabel: string;
  lightLabel: string;
}

const {
  theme = "system",
  label,
  systemLabel,
  darkLabel,
  lightLabel,
} = Astro.props;
---

<div class="relative inline-flex">
  <label class="sr-only" for="theme-switcher" data-i18n="landing.theme.label">{label}</label>

  <select
    id="theme-switcher"
    data-theme-toggle
    aria-label={label}
    data-i18n="landing.theme.label"
    data-i18n-attr="aria-label"
    class="h-11 cursor-pointer appearance-none rounded-2xl border border-white/10 bg-white/[0.03] px-4 pr-11 text-sm font-medium text-white backdrop-blur-xl outline-none transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] focus:border-primary focus:ring-4 focus:ring-primary/20"
  >
    <option value="system" selected={theme === "system"} class="bg-[#0f172a] text-white" data-i18n="landing.theme.system">
      {systemLabel}
    </option>
    <option value="dark" selected={theme === "dark"} class="bg-[#0f172a] text-white" data-i18n="landing.theme.dark">
      {darkLabel}
    </option>
    <option value="light" selected={theme === "light"} class="bg-[#0f172a] text-white" data-i18n="landing.theme.light">
      {lightLabel}
    </option>
  </select>

  <div
    class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-white/60"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</div>