---
import {
  Sun,
  Moon,
  Monitor,
  Check,
} from "@lucide/astro";

export interface Props {
  theme?: "system" | "dark" | "light";
  label: string;
  class?: string;
}

const {
  theme = "system",
  label,
} = Astro.props;
---

<div class="relative inline-block">
  <!-- trigger -->
  <button
    type="button"
    aria-label={label}
    data-theme-toggle
    data-theme-state={theme}
    class={`relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] text-white/80 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] ${Astro.props.class || ""}`}
  >
    <Monitor
      class="theme-icon theme-system h-4 w-4"
    />

    <Sun
      class="theme-icon theme-light h-4 w-4"
    />

    <Moon
      class="theme-icon theme-dark h-4 w-4"
    />
  </button>

  <!-- popover -->
  <div
    data-theme-popover
    class="absolute right-0 top-14 z-50 hidden min-w-[180px] overflow-hidden rounded-2xl border border-white/10 bg-[#0f172a]/95 p-2 text-sm shadow-2xl backdrop-blur-xl"
  >
    <button
      type="button"
      data-theme-option="light"
      class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
    >
      <div class="flex items-center gap-3">
        <Sun class="h-4 w-4" />
        <span>Light</span>
      </div>

      <Check
        data-theme-check="light"
        class="hidden h-4 w-4"
      />
    </button>

    <button
      type="button"
      data-theme-option="dark"
      class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
    >
      <div class="flex items-center gap-3">
        <Moon class="h-4 w-4" />
        <span>Dark</span>
      </div>

      <Check
        data-theme-check="dark"
        class="hidden h-4 w-4"
      />
    </button>

    <button
      type="button"
      data-theme-option="system"
      class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
    >
      <div class="flex items-center gap-3">
        <Monitor class="h-4 w-4" />
        <span>System</span>
      </div>

      <Check
        data-theme-check="system"
        class="hidden h-4 w-4"
      />
    </button>
  </div>
</div>