---
import { Landmark, Menu, X, Sun, Moon, Monitor, Check } from '@lucide/astro';
import Button from './ui/Button.astro';
import { NavProps } from '../types';

const { t, languages, currentLocale, theme } = Astro.props as NavProps;
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[rgba(10,15,30,0.72)] backdrop-blur-2xl supports-[backdrop-filter]:bg-[rgba(10,15,30,0.58)]"
>
  <div class="container mx-auto max-w-7xl flex h-20 items-center justify-between px-4">
    <!-- Logo -->
    <a
      href="/"
      class="group flex items-center gap-3 transition-opacity duration-300 hover:opacity-90"
      aria-label="Banka Home"
    >
      <div
        class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 shadow-[0_0_30px_rgba(255,255,255,0.04)] backdrop-blur-xl transition-all duration-300 group-hover:border-primary/30 group-hover:bg-primary/10"
      >
        <Landmark class="h-5 w-5 text-[var(--primary)]" />
      </div>

      <div class="flex flex-col leading-none">
        <span class="text-lg font-semibold tracking-[0.18em] text-white sm:text-xl"> BANKA </span>

        <span class="hidden text-[10px] uppercase tracking-[0.24em] text-white/45 sm:block">
          Modern Digital Banking
        </span>
      </div>
    </a>

    <!-- Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Toggle for mobile -->
      <div class="relative inline-block sm:hidden mr-6">
        <button
          type="button"
          aria-label={t('landing.theme.label', 'Theme')}
          data-theme-toggle
          data-theme-state={theme}
          class={`relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] text-white/80 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] `}
        >
          <Monitor class="theme-icon theme-system h-4 w-4" />
          <Sun class="theme-icon theme-light h-4 w-4" />
          <Moon class="theme-icon theme-dark h-4 w-4" />
        </button>

        <div
          data-theme-popover
          class="absolute right-0 top-14 z-50 hidden min-w-[180px] overflow-hidden rounded-2xl border border-white/10 bg-[#0f172a]/95 p-2 text-sm shadow-2xl backdrop-blur-xl"
        >
          <button
            type="button"
            data-theme-option="light"
            class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
          >
            <div class="flex items-center gap-3">
              <Sun class="h-4 w-4" />
              <span>Light</span>
            </div>

            <Check data-theme-check="light" class="hidden h-4 w-4" />
          </button>

          <button
            type="button"
            data-theme-option="dark"
            class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10 da"
          >
            <div class="flex items-center gap-3">
              <Moon class="h-4 w-4" />
              <span>Dark</span>
            </div>

            <Check data-theme-check="dark" class="hidden h-4 w-4" />
          </button>

          <button
            type="button"
            data-theme-option="system"
            class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
          >
            <div class="flex items-center gap-3">
              <Monitor class="h-4 w-4" />
              <span>System</span>
            </div>

            <Check data-theme-check="system" class="hidden h-4 w-4" />
          </button>
        </div>
      </div>
      <button
        data-mobile-menu-toggle
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle mobile menu"
        class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white backdrop-blur-xl transition-all duration-300 hover:bg-white/10 sm:hidden"
        type="button"
      >
        <Menu class="h-5 w-5" data-menu-open />
        <X class="hidden h-5 w-5" data-menu-close />
      </button>
      <div class="sm:inline-flex gap-2 hidden">
        <Button
          variant="secondary"
          class="inline-flex px-5 py-2.5 text-sm font-medium whitespace-nowrap"
          data-i18n="landing.signIn"
        >
          {t('landing.signIn', 'Sign In')}
        </Button>

        <Button
          class="inline-flex items-center justify-center whitespace-nowrap rounded-xl px-5 py-2.5 text-sm font-semibold shadow-[0_10px_30px_rgba(59,130,246,0.18)] transition-all duration-300 hover:scale-[1.02]"
        >
          <span data-i18n="landing.openAccount">{t('landing.openAccount', 'Open an Account')}</span>
        </Button>

        <!-- Theme Toggle -->
        <div class="relative inline-block">
          <button
            type="button"
            aria-label={t('landing.theme.label', 'Theme')}
            data-theme-toggle
            data-theme-state={theme}
            class={`relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] text-white/80 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] `}
          >
            <Monitor class="theme-icon theme-system h-4 w-4" />
            <Sun class="theme-icon theme-light h-4 w-4" />
            <Moon class="theme-icon theme-dark h-4 w-4" />
          </button>

          <div
            data-theme-popover
            class="absolute right-0 top-14 z-50 hidden min-w-[180px] overflow-hidden rounded-2xl border border-white/10 bg-[#0f172a]/95 p-2 text-sm shadow-2xl backdrop-blur-xl"
          >
            <button
              type="button"
              data-theme-option="light"
              class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
            >
              <div class="flex items-center gap-3">
                <Sun class="h-4 w-4" />
                <span>Light</span>
              </div>

              <Check data-theme-check="light" class="hidden h-4 w-4" />
            </button>

            <button
              type="button"
              data-theme-option="dark"
              class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10 da"
            >
              <div class="flex items-center gap-3">
                <Moon class="h-4 w-4" />
                <span>Dark</span>
              </div>

              <Check data-theme-check="dark" class="hidden h-4 w-4" />
            </button>

            <button
              type="button"
              data-theme-option="system"
              class="theme-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-white/80 transition hover:bg-white/10"
            >
              <div class="flex items-center gap-3">
                <Monitor class="h-4 w-4" />
                <span>System</span>
              </div>

              <Check data-theme-check="system" class="hidden h-4 w-4" />
            </button>
          </div>
        </div>

        <!-- Language Switcher -->
        <div class="relative ml-1 inline-flex" data-language-dropdown="desktop">
          <button
            class="h-11 px-4 rounded-2xl border border-white/10 bg-white/[0.03] text-sm font-medium text-white backdrop-blur-xl outline-none transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] focus:border-primary focus:ring-4 focus:ring-primary/20 flex items-center gap-2"
            data-language-toggle
            title="Change language"
            aria-label={t('landing.languageSwitcher', 'Select language')}
            data-i18n="landing.languageSwitcher"
            data-i18n-attr="aria-label"
          >
            <span data-language-flag class={languages.find((l) => l.code === currentLocale)?.flag}
            ></span>
            <span data-language-current
              >{languages.find((l) => l.code === currentLocale)?.code}</span
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-white/60"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div
            data-language-panel
            class="hidden absolute top-full mt-1 w-48 rounded-2xl border border-white/10 bg-[rgba(10,15,30,0.94)] backdrop-blur-xl overflow-hidden z-50"
          >
            {
              languages.map((lang) => (
                <button
                  type="button"
                  data-language-option={lang.code}
                  class="w-full px-4 py-3 text-left text-sm font-medium text-white/80 hover:bg-white/10 transition-colors flex items-center gap-3"
                >
                  <span data-language-flag class={lang.flag} />
                  <span>{lang.code}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <div
        data-mobile-menu
        id="mobile-menu"
        class="pointer-events-none invisible absolute inset-x-0 top-full border-b border-white/10 bg-[rgba(10,15,30,0.94)] opacity-0 backdrop-blur-2xl transition-all duration-300"
        aria-hidden="true"
      >
        <div class="flex flex-col gap-4 px-4 py-5">
          <Button
            variant="secondary"
            class="w-full justify-center py-3 text-sm font-medium"
            data-i18n="landing.signIn"
          >
            {t('landing.signIn', 'Sign In')}
          </Button>

          <Button class="w-full justify-center rounded-xl py-3 text-sm font-semibold">
            <span data-i18n="landing.openAccount">
              {t('landing.openAccount', 'Open an Account')}
            </span>
          </Button>
          <!-- Mobile Dropdown Panel -->
          <div
            data-language-panel
            class="hidden absolute top-full mt-1 left-0 right-0 rounded-2xl border border-white/10 bg-[rgba(10,15,30,0.94)] backdrop-blur-xl overflow-hidden z-50"
          >
            {
              languages.map((lang) => (
                <button
                  type="button"
                  data-language-option={lang.code}
                  class="w-full px-4 py-3 text-left text-sm font-medium text-white/80 hover:bg-white/10 transition-colors flex items-center gap-3"
                >
                  <span data-language-flag class={lang.flag} />
                  <span data-i18n={lang.labelKey}>{lang.label}</span>
                </button>
              ))
            }
          </div>
        </div>
        <div class="relative w-full" data-language-dropdown="mobile" data-state="closed">
          <button
            type="button"
            data-language-toggle
            aria-expanded="false"
            aria-controls="mobile-language-panel"
            class="flex h-11 w-full items-center justify-between gap-2 rounded-2xl border border-white/10 bg-white/[0.03] px-4 text-sm font-medium text-white backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05]"
          >
            <span class="flex items-center gap-2">
              <span data-language-flag class={languages.find((l) => l.code === currentLocale)?.flag}
              ></span>
              <span data-language-current>
                {languages.find((l) => l.code === currentLocale)?.code}
              </span>
            </span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-white/60 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              data-language-chevron
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="mobile-language-panel"
            data-language-panel
            class="mt-2 max-h-0 overflow-hidden rounded-2xl border border-white/10 bg-[#0f172a]/95 opacity-0 shadow-xl backdrop-blur-xl transition-all duration-300 ease-out"
          >
            <div
              class="px-4 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-white/60"
              data-i18n="landing.languageSwitcher"
            >
              Change language
            </div>
            {
              languages.map((lang) => (
                <button
                  type="button"
                  data-language-option={lang.code}
                  class="flex w-full appearance-none items-center gap-2 border-0 bg-transparent px-4 py-2 text-left text-sm text-white/80 transition hover:bg-white/10 hover:text-white"
                >
                  <span class={lang.flag} />
                  <span>{lang.code}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
