---
import { Landmark } from "@lucide/astro";
import GlassButton from "./ui/GlassButton.astro";
import ThemeToggle from "./ThemeToggle.astro";

const { t, languages, currentLocale, theme } = Astro.props;
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[rgba(10,15,30,0.72)] backdrop-blur-2xl supports-[backdrop-filter]:bg-[rgba(10,15,30,0.58)]"
>
  <div
    class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <a
      href="/"
      class="group flex items-center gap-3 transition-opacity duration-300 hover:opacity-90"
      aria-label="Banka Home"
    >
      <div
        class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 shadow-[0_0_30px_rgba(255,255,255,0.04)] backdrop-blur-xl transition-all duration-300 group-hover:border-primary/30 group-hover:bg-primary/10"
      >
        <Landmark class="h-5 w-5 text-[var(--primary)]" />
      </div>

      <div class="flex flex-col leading-none">
        <span
          class="text-lg font-semibold tracking-[0.18em] text-white sm:text-xl"
        >
          BANKA
        </span>

        <span
          class="hidden text-[10px] uppercase tracking-[0.24em] text-white/45 sm:block"
        >
          Modern Digital Banking
        </span>
      </div>
    </a>

    <!-- Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <GlassButton
        variant="secondary"
        class="hidden sm:inline-flex px-5 py-2.5 text-sm font-medium"
        data-i18n="landing.signIn"
      >
        {t("landing.signIn", "Sign In")}
      </GlassButton>

      <GlassButton
        class="hidden sm:inline-flex items-center justify-center whitespace-nowrap rounded-xl px-5 py-2.5 text-sm font-semibold shadow-[0_10px_30px_rgba(59,130,246,0.18)] transition-all duration-300 hover:scale-[1.02]"
      >
        <span data-i18n="landing.openAccount">{t("landing.openAccount", "Open an Account")}</span>
      </GlassButton>

      <!-- Theme Toggle -->
      <ThemeToggle
        theme={theme}
        label={t("landing.theme.label", "Theme")}
        systemLabel={t("landing.theme.system", "System")}
        darkLabel={t("landing.theme.dark", "Dark")}
        lightLabel={t("landing.theme.light", "Light")}
      />

      <!-- Language Switcher -->
      <div class="relative ml-1 hidden sm:inline-flex">
        <select
          id="language-switcher"
          data-language-switcher
          aria-label={t("landing.languageSwitcher", "Select language")}
          data-i18n="landing.languageSwitcher"
          data-i18n-attr="aria-label"
          class="h-11 cursor-pointer appearance-none rounded-2xl border border-white/10 bg-white/[0.03] px-4 pr-11 text-sm font-medium text-white backdrop-blur-xl outline-none transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05] focus:border-primary focus:ring-4 focus:ring-primary/20"
        >
          {
            languages.map((lang) => (
              <option
                value={lang.code}
                selected={currentLocale === lang.code}
                class="bg-[#0f172a] text-white"
                data-i18n={lang.labelKey}
              >
                {lang.label}
              </option>
            ))
          }
        </select>

        <!-- Chevron -->
        <div
          class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-white/60"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </div>
      </div>
    </div>
  </div>
</nav>