---
import { createTranslator } from "../utils/ui";
import GlassCard from "./ui/GlassCard.astro";

const { t, features  } = Astro.props;

---

  <section class="py-10 px-4">
    <div class="container mx-auto">
      <h2 class="text-3xl font-bold text-center text-foreground mb-12">
        {t("landing.whyTitle", "Why BANKA?")}
      </h2>

      <div class="bento-grid">
        {
          features.map((f: any) => {
            const Icon = f.icon;

            return (
              <GlassCard key={f.titleKey} className="group glass-surface-lift">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                  <Icon class="h-6 w-6 text-primary" />
                </div>

                <h3 class="text-lg font-semibold text-foreground mb-2">
                  {t(f.titleKey)}
                </h3>

                <p class="text-muted-foreground text-sm">{t(f.descKey)}</p>
              </GlassCard>
            );
          })
        }
      </div>
    </div>
  </section>
