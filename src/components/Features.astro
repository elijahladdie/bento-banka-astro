---
import Card from './ui/Card.astro';
import { FeaturesProps, FeatureItem } from '../types';

const { t, features } = Astro.props as FeaturesProps;
---

<section class="py-10 px-4">
  <div class="container mx-auto">
    <h2 class="text-3xl font-bold text-center text-foreground mb-12">
      <span data-i18n="landing.whyTitle">{t('landing.whyTitle', 'Why BANKA?')}</span>
    </h2>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f: FeatureItem) => {
          const Icon = f.icon;

          return (
            <Card class="group transition-transform hover:-translate-y-1">
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                <Icon class="h-6 w-6 text-primary" />
              </div>

              <h3 class="text-lg font-semibold text-foreground mb-2">
                <span data-i18n={f.titleKey}>{t(f.titleKey)}</span>
              </h3>

              <p class="text-muted-foreground text-sm" data-i18n={f.descKey}>
                {t(f.descKey)}
              </p>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>
