---
export interface Props {
  cardCount?: number;
}

const {
  cardCount = 3
} = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  {
    Array.from({ length: cardCount }).map((_, index) => (
      <div
        class="glass-card w-full p-6 md:p-7"
        aria-hidden="true"
      >
        <div class="flex h-full flex-col gap-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 space-y-3">
              <div class="glass-skeleton h-4 w-20 rounded-full" />
              <div class="glass-skeleton h-7 w-3/5 rounded-lg" />

              <div class="space-y-2">
                <div class="glass-skeleton h-3 w-full rounded-full" />

                <div class="glass-skeleton h-3 w-11/12 rounded-full" />

                <div class="glass-skeleton h-3 w-4/5 rounded-full" />
              </div>
            </div>

            <div class="glass-skeleton h-8 w-20 rounded-full" />
          </div>

          <div class="mt-3 flex items-end gap-3">
            <div class="glass-skeleton h-12 w-28 rounded-xl" />

            <div class="glass-skeleton h-4 w-24 rounded-full" />
          </div>

          <div class="flex min-h-[28px] gap-2">
            <div class="glass-skeleton h-6 w-20 rounded-full" />
          </div>

          <div class="mt-auto">
            <div class="glass-skeleton h-12 w-full rounded-full" />
          </div>
        </div>
      </div>
    ))
  }
</div>