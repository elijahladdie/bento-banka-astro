---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import { getBillingLabel, formatCurrency } from "../../utils/format";
import type { PricingCardProps } from "../../types";
import { CircleCheck } from "@lucide/astro";

const {
  plan,
  locale,
  freeLabel,
  billingMonthLabel,
  billingYearLabel,
  popularLabel,
  trialLabel,
  ctaLabel,
} = Astro.props as PricingCardProps;

const formattedPrice = formatCurrency(
  locale,
  plan.priceAmount,
  plan.currencyCode,
  freeLabel,
);

const billingLabel = getBillingLabel(plan, billingMonthLabel, billingYearLabel);
---
<Card
  heavy={plan.popular}
  padding="lg"
  class={`flex h-full flex-col transition-transform ${
    plan.popular
      ? "scale-105 z-10 relative border border-[rgba(110,180,80,0.55)] shadow-[0_20px_60px_rgba(110,180,80,0.12)] bg-[linear-gradient(135deg,#d4af37_0%,#f0d060_50%,#a8880a_100%)] text-[#0a0a0a]"
      : ""
  }`}
  data-plan-id={plan.id}
  data-price-amount={plan.priceAmount}
  data-price-currency={plan.currencyCode}
>
  <div class="flex h-full flex-col">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-xl font-semibold text-[var(--text-primary)]">
          {plan.name}
        </h3>

        <p
          class="mt-2 whitespace-pre-line text-sm leading-6 text-[var(--text-secondary)]"
        >
          {plan.description}
        </p>
      </div>

      {
        plan.popular && (
          <span class="inline-flex shrink-0 rounded-full border border-[rgba(110,180,80,0.55)] bg-[rgba(110,180,80,0.18)] px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-[rgba(110,180,80,0.9)]">
            <span data-i18n="landing.pricing.popular">{popularLabel}</span>
          </span>
        )
      }
    </div>

    <div class="mt-8 flex items-end gap-3">
      <span
        class="text-4xl font-semibold tracking-tight text-[var(--text-primary)]"
      >
        <span data-price-amount>{formattedPrice}</span> /
      </span>

      <span
        class="pb-1 text-sm text-[var(--text-secondary)]"
        data-billing-label
      >
        {billingLabel}
      </span>
    </div>
    <div class="my-4">
      <Button
        type="button"
        fullWidth
        variant={plan.popular ? "secondary" : "primary"}
        data-paddle-price-id={plan.price_id ?? undefined}
        data-paddle-plan-name={plan.name}
        data-i18n="landing.pricing.cta"
        aria-label={`${ctaLabel} ${plan.name}`}
      >
        {ctaLabel}
      </Button>
    </div>

    {
      plan.trialLabel && (
        <div class="mt-2 flex min-h-[28px] flex-wrap items-center gap-2">
          <span class="inline-flex rounded-full border border-[rgba(96,165,250,0.35)] bg-[rgba(59,130,246,0.12)] px-3 py-1 text-xs font-medium text-[var(--info-primary)]">
            {plan.trialLabel}
          </span>

          <span
            class="text-xs text-[var(--text-muted)]"
            data-i18n="landing.pricing.trial"
          >
            {trialLabel}
          </span>
        </div>
      )
    }

    <p class="py-2 mt-2 text-sm font-bold text-[var(--text-muted)]">
      <span data-i18n="landing.pricing.included">What's included</span>
    </p>

    {
      plan.features.length > 0 && (
        <div class="group relative">
          <button
            type="button"
            class="w-full cursor-help rounded-2xl text-left"
            aria-label={`${plan.name} features`}
          >
            <div class="space-y-3 text-sm leading-6 text-[var(--text-secondary)]">
              {plan.features.map((feature) => (
                <div class="flex items-start gap-3">
                  <CircleCheck
                    class={`mt-1 h-4 w-4 shrink-0 ${
                      plan.popular
                        ? "text-[rgb(20,20,20)]"
                        : "text-[var(--gold)]"
                    }`}
                  />
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </button>
        </div>
      )
    }
  </div>
</Card>
