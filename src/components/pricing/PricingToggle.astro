---
import type { PricingInterval } from "./types";

export interface Props {
  interval: PricingInterval;
  monthlyLabel: string;
  yearlyLabel: string;
}

const {
  interval,
  monthlyLabel,
  yearlyLabel,
} = Astro.props;

const isYearly = interval === "year";
---

<div
  class="flex items-center justify-center gap-4 mt-8"
>
  <!-- Monthly Label -->
  <span
    class="text-sm font-medium transition-colors duration-300 text-gold",
    data-i18n="landing.pricing.monthly"
  >
    {monthlyLabel}
  </span>

  <!-- Switch -->
  <button
  type="button"
  role="switch"
  aria-checked={isYearly}
  data-pricing-switch
  data-current-interval={interval}
  class:list={[
    "relative inline-flex h-8 w-16 shrink-0 cursor-pointer items-center rounded-full border transition-all duration-300",
    "backdrop-blur-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40",
    "bg-[var(--glass-bg)] border-[var(--glass-border)]",
    isYearly
      ? "bg-primary/20 border-primary/30"
      : "",
  ]}
>
    <!-- Track Glow -->
    <span
      class="absolute inset-0 rounded-full bg-gradient-to-r from-primary/20 to-primary/5 opacity-80"
    />

    <!-- Thumb -->
    <span
      class:list={[
        "relative z-10 flex h-6 w-6 items-center justify-center rounded-full bg-white shadow-lg transition-all duration-300",
        isYearly
          ? "translate-x-9"
          : "translate-x-1",
      ]}
      data-switch-thumb
    >
    </span>
  </button>

  <!-- Yearly Label -->
  <span
    class:list={[
      "text-sm font-medium transition-colors duration-300 text-gold",
    ]}
    data-i18n="landing.pricing.yearly"
  >
    {yearlyLabel}
  </span>
</div>