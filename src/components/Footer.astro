---
const { translations } = Astro.props;
import { Landmark } from "@lucide/astro";
---

    <footer class="py-16 px-4 border-t border-border">
      <div class="container mx-auto">

        <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">

          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-2">
              <Landmark class="h-6 w-6 text-primary" />

              <span class="text-lg font-bold text-foreground">
                BANKA
              </span>
            </div>

            <p class="text-sm text-muted-foreground max-w-sm">
              {translations.footerLine}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 md:items-center">
            <button class="px-4 py-2 rounded-lg bg-primary/10 hover:bg-primary/20 transition">
              {translations.signIn}
            </button>

            <button class="px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:opacity-90 transition">
              {translations.openAccount}
            </button>
          </div>

        </div>

        <div class="mt-10 pt-6 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-xs text-muted-foreground">
            {translations.copyright}
          </p>
        </div>

      </div>
    </footer>