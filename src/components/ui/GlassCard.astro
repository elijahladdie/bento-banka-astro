---
import { cn } from "../../utils/cn";

export interface Props {
  heavy?: boolean;
  padding?: "none" | "sm" | "md" | "lg";
  nohover?: boolean;
  class?: string;
}

const {
  heavy = false,
  padding = "md",
  nohover = false,
  class: className,
  ...props
} = Astro.props;

const paddings = {
  none: "",
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};
---

<div
  data-nohover={nohover ? "true" : "false"}
  class={cn(
    heavy ? "glass-card-heavy" : "glass-card",
    paddings[padding],
    nohover && "hover:transform-none",
    className
  )}
  {...props}
>
  <slot />
</div>