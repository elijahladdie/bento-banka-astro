---
export const prerender = false;
import PricingCard from "./pricing/PricingCard.astro";
import type { PricingApiResponse, PricingInterval, PricingPlan, PricingProps } from "../types";
import { createTranslator } from "../utils/ui";
import { mapPricingPlans } from "../utils/format";

const { locale = "en" } = Astro.props as PricingProps;
const t = createTranslator(locale);

const storedInterval = Astro.cookies.get("pricingInterval")?.value;
const interval: PricingInterval = storedInterval === "year" ? "year" : "month";

let plans: PricingPlan[] = [];
let pricingError: string | null = null;

try {
  const productsRes = await fetch(
    new URL(`/api/pricing?interval=${interval}`, Astro.url),
    {
      headers: {
        Accept: "application/json",
      },
    },
  );

  if (!productsRes.ok) {
    throw new Error(
      `Pricing request failed with status ${productsRes.status}`,
    );
  }

  const payload = await productsRes.json() as PricingApiResponse;
  plans = mapPricingPlans(payload, interval);
} catch (error) {
  pricingError = error instanceof Error ? error.message : t("landing.pricing.errorBody");
  plans = [];
}

---

<section
  id="pricing"
  class="relative overflow-hidden px-4 py-20 sm:py-24"
  data-pricing-root
  data-pricing-interval={interval}
  data-pricing-free-label={t("landing.pricing.free")}
  data-pricing-billing-month-label={t("landing.pricing.billingMonth")}
  data-pricing-billing-year-label={t("landing.pricing.billingYear")}
  data-pricing-cta-label={t("landing.pricing.cta")}
  data-pricing-error-body={t("landing.pricing.errorBody")}
  data-pricing-retry-label={t("landing.pricing.retry")}
>
  <div class="container mx-auto relative z-10">
    <div class="mx-auto mb-5 max-w-3xl text-center sm:mb-14">
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--text-gold)]"
      >
        <span data-i18n="landing.pricing.kicker">{t("landing.pricing.kicker", "Pricing")}</span>
      </p>
      <h2
        class="mt-3 text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl lg:text-5xl"
      >
        <span data-i18n="landing.pricing.title">{t("landing.pricing.title")}</span>
      </h2>
      <p
        class="mt-4 text-sm leading-7 text-[var(--text-secondary)] sm:text-base"
      >
        <span data-i18n="landing.pricing.subtitle">{t("landing.pricing.subtitle")}</span>
      </p>
    </div>

    <div class="flex items-center justify-center gap-4 mt-8">
      <span class="text-sm font-medium transition-colors duration-300 text-gold" data-i18n="landing.pricing.monthly">
        {t("landing.pricing.monthly")}
      </span>

      <button
        type="button"
        role="switch"
        aria-checked={interval === "year"}
        data-pricing-switch
        data-current-interval={interval}
        class:list={[
          "relative inline-flex h-8 w-16 shrink-0 cursor-pointer items-center rounded-full border transition-all duration-300",
          "backdrop-blur-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40",
          "bg-[var(--glass-bg)] border-[var(--glass-border)]",
          interval === "year" ? "bg-primary/20 border-primary/30" : "",
        ]}
      >
        <span class="absolute inset-0 rounded-full bg-gradient-to-r from-primary/20 to-primary/5 opacity-80" />

        <span
          class:list={[
            "relative z-10 flex h-6 w-6 items-center justify-center rounded-full bg-white shadow-lg transition-all duration-300",
            interval === "year" ? "translate-x-9" : "translate-x-1",
          ]}
          data-switch-thumb
        />
      </button>

      <span class="text-sm font-medium transition-colors duration-300 text-gold" data-i18n="landing.pricing.yearly">
        {t("landing.pricing.yearly")}
      </span>
    </div>

    <div class="mx-auto w-full relative mt-10" data-pricing-panel>
      <div data-pricing-skeleton hidden>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {
            Array.from({ length: 3 }).map((_, index) => (
              <div
                class="relative overflow-hidden transition-[var(--transition-base)] bg-[var(--glass-bg)] border border-[var(--glass-border)] rounded-2xl backdrop-blur-[var(--glass-blur)] shadow-sm w-full p-6 md:p-7"
                aria-hidden="true"
              >
                <div class="flex h-full flex-col gap-5">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1 space-y-3">
                      <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-4 w-20 rounded-full" />
                      <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-7 w-3/5 rounded-lg" />

                      <div class="space-y-2">
                        <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-3 w-full rounded-full" />

                        <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-3 w-11/12 rounded-full" />

                        <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-3 w-4/5 rounded-full" />
                      </div>
                    </div>

                    <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-8 w-20 rounded-full" />
                  </div>

                  <div class="mt-3 flex items-end gap-3">
                    <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-12 w-28 rounded-xl" />

                    <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-4 w-24 rounded-full" />
                  </div>

                  <div class="flex min-h-[28px] gap-2">
                    <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-6 w-20 rounded-full" />
                  </div>

                  <div class="mt-auto">
                    <div class="animate-pulse rounded-full bg-white/10 dark:bg-white/5 h-12 w-full rounded-full" />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div data-pricing-content>
        {
          pricingError ? (
            <div class="mx-auto max-w-2xl">
            <div class="relative overflow-hidden transition-[var(--transition-base)] bg-[var(--glass-bg)] border border-[var(--glass-border)] rounded-2xl backdrop-blur-[var(--glass-blur)] shadow-sm p-8 text-center">
              <div class="flex flex-col items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[rgba(248,113,113,0.35)] bg-[rgba(248,113,113,0.12)] text-[var(--error-text)]">
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h17.94a2 2 0 0 0 1.71-3l-8.47-14.14a2 2 0 0 0-3.42 0Z" />
                  </svg>
                </div>

                <div>
                  <h3 class="text-2xl font-semibold text-[var(--text-primary)]">
                        <span data-i18n="landing.pricing.errorTitle">{t("landing.pricing.errorTitle")}</span>
                  </h3>

                  <p class="mt-2 text-sm leading-7 text-[var(--text-secondary)]">
                        <span data-i18n="landing.pricing.errorBody">{t("landing.pricing.errorBody")}</span>
                  </p>
                </div>

                <a
                  href={Astro.url.pathname}
                  class="inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold text-white transition-transform duration-200 shadow-lg bg-gradient-to-r from-yellow-400 to-yellow-600 hover:scale-[1.02]"
                  data-i18n="landing.pricing.retry"
                >
                  {t("landing.pricing.retry")}
                </a>
              </div>
            </div>
            </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-pricing-grid>
            {plans.map((plan) => (
              <PricingCard
                plan={plan}
                locale={locale}
                freeLabel={t("landing.pricing.free")}
                billingMonthLabel={t("landing.pricing.billingMonth")}
                billingYearLabel={t("landing.pricing.billingYear")}
                popularLabel={t("landing.pricing.popular")}
                trialLabel={t("landing.pricing.trial")}
                ctaLabel={t("landing.pricing.cta")}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>