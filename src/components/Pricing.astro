---
import PricingCard from "./pricing/PricingCard.astro";
import PricingSkeleton from "./pricing/PricingSkeleton.astro";
import PricingToggle from "./pricing/PricingToggle.astro";
import type { PricingApiResponse, PricingInterval, PricingPlan } from "./pricing/types";
import { createTranslator } from "../utils/ui";
import { transformPricingResponse } from "../utils/format";

const { locale = "en" } = Astro.props;
const t = createTranslator(locale);

const storedInterval = Astro.cookies.get("pricingInterval")?.value;
const interval: PricingInterval = storedInterval === "year" ? "year" : "month";

let plans: PricingPlan[] = [];
let pricingError: string | null = null;
try {
  const productsRes = await fetch(new URL(`${import.meta.env.PUBLIC_API_URL}/api/paddle/products?interval=${interval}`, import.meta.env.PUBLIC_API_URL));
  const payload = await productsRes.json() as PricingApiResponse;
  plans = transformPricingResponse(payload, interval);
} catch (error) {
  pricingError = error instanceof Error ? error.message : t("landing.pricing.errorBody");
  plans = [];
}

---

<section
  id="pricing"
  class="relative overflow-hidden px-4 py-20 sm:py-24"
  data-pricing-root
  data-pricing-interval={interval}
  data-pricing-free-label={t("landing.pricing.free")}
  data-pricing-billing-month-label={t("landing.pricing.billingMonth")}
  data-pricing-billing-year-label={t("landing.pricing.billingYear")}
  data-pricing-cta-label={t("landing.pricing.cta")}
  data-pricing-error-body={t("landing.pricing.errorBody")}
  data-pricing-retry-label={t("landing.pricing.retry")}
>
  <div class="container mx-auto relative z-10">
    <div class="mx-auto mb-5 max-w-3xl text-center sm:mb-14">
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--text-gold)]"
      >
        <span data-i18n="landing.pricing.kicker">{t("landing.pricing.kicker", "Pricing")}</span>
      </p>
      <h2
        class="mt-3 text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl lg:text-5xl"
      >
        <span data-i18n="landing.pricing.title">{t("landing.pricing.title")}</span>
      </h2>
      <p
        class="mt-4 text-sm leading-7 text-[var(--text-secondary)] sm:text-base"
      >
        <span data-i18n="landing.pricing.subtitle">{t("landing.pricing.subtitle")}</span>
      </p>
    </div>

    <PricingToggle
      interval={interval}
      monthlyLabel={t("landing.pricing.monthly")}
      yearlyLabel={t("landing.pricing.yearly")}
    />

    <div class="mx-auto w-full relative mt-10" data-pricing-panel>
      <div data-pricing-skeleton hidden>
        <PricingSkeleton cardCount={3} />
      </div>

      <div data-pricing-content>
        {
          pricingError ? (
            <div class="mx-auto max-w-2xl">
            <div class="glass-card p-8 text-center">
              <div class="flex flex-col items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[rgba(248,113,113,0.35)] bg-[rgba(248,113,113,0.12)] text-[var(--error-text)]">
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h17.94a2 2 0 0 0 1.71-3l-8.47-14.14a2 2 0 0 0-3.42 0Z" />
                  </svg>
                </div>

                <div>
                  <h3 class="text-2xl font-semibold text-[var(--text-primary)]">
                        <span data-i18n="landing.pricing.errorTitle">{t("landing.pricing.errorTitle")}</span>
                  </h3>

                  <p class="mt-2 text-sm leading-7 text-[var(--text-secondary)]">
                        <span data-i18n="landing.pricing.errorBody">{t("landing.pricing.errorBody")}</span>
                  </p>
                </div>

                <a
                  href={Astro.url.pathname}
                  class="btn-primary glass-surface-lift inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold"
                  data-i18n="landing.pricing.retry"
                >
                  {t("landing.pricing.retry")}
                </a>
              </div>
            </div>
            </div>
          </div>
        ) : (
          <div class="pricing-grid" data-pricing-grid>
            {plans.map((plan) => (
              <PricingCard
                plan={plan}
                locale={locale}
                freeLabel={t("landing.pricing.free")}
                billingMonthLabel={t("landing.pricing.billingMonth")}
                billingYearLabel={t("landing.pricing.billingYear")}
                popularLabel={t("landing.pricing.popular")}
                trialLabel={t("landing.pricing.trial")}
                ctaLabel={t("landing.pricing.cta")}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>